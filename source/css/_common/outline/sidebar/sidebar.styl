#sidebar {
  min-height: 100vh;
  position: static;
  overflow-x: hidden;
  overflow-y: scroll;
  width: $sidebar-desktop;
  top: 0;
  bottom: 0;
  the-transition();

  +tablet-mobile() {
    display: none;
    position: fixed;
    right: 0;
    height: 100vh;
    height: 100dvh;
    min-height: 100vh;
    min-height: 100dvh;
    overflow-y: hidden;
    transition:
      background-color .2s ease-in-out,
      box-shadow .2s ease-in-out;
    background: var(--grey-1);
    box-shadow: 0 .375rem .9375rem .3125rem rgba(0, 0, 0, .2);
    z-index: $zindex-3;

    >.inner {
      height: 100vh;
      height: 100dvh;
      min-height: 100vh;
      min-height: 100dvh;
    }
  }

  &.affix {
    >.inner {
      position: fixed;
      top: 0;
    }
    .panels {
      padding-top: 3.625rem;
      height: 100vh;
    }
  }

  >.inner {
    position: relative;
    width: $sidebar-desktop;
    max-width: $sidebar-desktop;
    min-width: 0;
    min-height: 100vh;
    height: 100vh;
    color: var(--grey-6);
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    z-index: $zindex-1;
  }
}

.panels {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  min-height: 0;
  min-width: 0;
  padding: 3.25rem 0 .75rem;
  width: 100%;
  max-width: 100%;
  overflow: hidden;

  .inner {
    box-sizing: border-box;
    flex: 1 1 auto;
    min-height: 0;
    min-width: 0;
    margin-top: .75rem;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    width: 100%;
    max-width: 100%;
    height: auto;

    box-shadow:
      inset 0 1rem 1rem -1rem transparent,
      inset 0 -1rem 1rem -1rem transparent;
    transition: box-shadow .2s ease;

    &.scroll-top {
      box-shadow:
        inset 0 1rem 1rem -1rem var(--box-bg-shadow),
        inset 0 -1rem 1rem -1rem transparent;
    }

    &.scroll-bottom {
      box-shadow:
        inset 0 1rem 1rem -1rem transparent,
        inset 0 -1rem 1rem -1rem var(--box-bg-shadow);
    }

    &.scroll-top.scroll-bottom,
    &.is-native-overscrolling {
      box-shadow: 
        inset 0 1rem 1rem -1rem var(--box-bg-shadow),
        inset 0 -1rem 1rem -1rem var(--box-bg-shadow);
    }

    +tablet-mobile() {
      box-shadow:
        inset 0 1rem 1rem -1rem transparent,
        inset 0 -1rem 1rem -1rem transparent !important;
      height: 100%;
      margin-top: 0;

      .panel.active {
        min-height: calc(100% + 1px);
      }

      &.scroll-top,
      &.scroll-bottom,
      &.scroll-top.scroll-bottom,
      &.is-native-overscrolling {
        box-shadow:
          inset 0 1rem 1rem -1rem transparent,
          inset 0 -1rem 1rem -1rem transparent !important;
      }
    }

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .panel {
    box-sizing: border-box;
    display: none;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    padding: .875rem .9375rem 2rem;
  }
}


@import 'dimmer';
@import 'author';
@import 'menu';
@import 'social';

@import 'quick';
@import 'tab';

@import 'toc';
@import 'related';
@import 'state';
