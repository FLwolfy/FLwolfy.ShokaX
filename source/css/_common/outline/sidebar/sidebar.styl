#sidebar {
  min-height: 100vh;
  position: static;
  overflow: scroll;
  width: $sidebar-desktop;
  top: 0;
  bottom: 0;
  the-transition();

  +tablet-mobile() {
    display: none;
    position: fixed;
    right: 0;
    background: var(--grey-1);
    box-shadow: 0 .375rem .9375rem .3125rem rgba(0, 0, 0, .2);
    z-index: $zindex-3;
  }

  &.affix {
    >.inner {
      position: fixed;
      top: 0;
    }
    .panels {
      padding-top: 3.625rem;
      height: 100vh;
    }
  }

  >.inner {
    position: relative;
    width: $sidebar-desktop;
    min-height: 100vh;
    height: 100vh;
    color: var(--grey-6);
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    z-index: $zindex-1;
  }
}

.panels {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  min-height: 0;
  padding: 3.25rem 0 .75rem;
  width: 100%;
  overflow: hidden;

  .inner {
    flex: 1 1 auto;
    min-height: 0;
    margin-top: .75rem;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    width: auto;
    height: auto;

    box-shadow: none;
    transition: box-shadow 0.2s ease;

    &.scroll-top {
      box-shadow: inset 0 1rem 1rem -1rem var(--box-bg-shadow);
    }

    &.scroll-bottom {
      box-shadow: inset 0 -1rem 1rem -1rem var(--box-bg-shadow);
    }

    &.scroll-top.scroll-bottom {
      box-shadow: 
        inset 0 1rem 1rem -1rem var(--box-bg-shadow),
        inset 0 -1rem 1rem -1rem var(--box-bg-shadow);
    }

    +tablet-mobile() {
      box-shadow: none !important;
      height: auto;
      margin-top: 0;
    }

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .panel {
    display: none;
    padding: .875rem .9375rem 2rem;
  }
}


@import 'dimmer';
@import 'author';
@import 'menu';
@import 'social';

@import 'quick';
@import 'tab';

@import 'toc';
@import 'related';
@import 'state';
